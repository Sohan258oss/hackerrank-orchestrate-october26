# Copy to .env (never commit .env). Only the vision extraction step (screenshots,
# image-only PDF pages) needs a key; everything else is parsed locally.

# Default provider: Gemini, model gemini-3.8-flash.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fallback provider: NVIDIA (Nemotron 3.5 VL). Used only with VISION_PROVIDER=nvidia.
# Free key: https://build.nvidia.com -> any model page -> "Get API Key" (starts with nvapi-)
# VISION_API_KEY=
# VISION_PROVIDER=nvidia

# Optional overrides. Any OpenAI-compatible /chat/completions endpoint with image input works.
# VISION_MODEL=gemini-3.8-flash
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# VISION_JSON_MODE=json_object
# VISION_MAX_TOKENS=16384
# VISION_TIMEOUT=300
